[Unit]
Description=Report sky-server services to status.skyhong.tw

[Service]
Type=oneshot
EnvironmentFile=%h/.config/sky-status-agent.env
ExecStart=/usr/bin/python3 -B %h/Projects/status.skyhong.tw/agent/skyserver_agent.py
StateDirectory=sky-status-agent
StateDirectoryMode=0700
TimeoutStartSec=120
UMask=0077
